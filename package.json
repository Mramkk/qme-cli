{
  "name": "@ramkumarbedia/xqme",
  "version": "1.1.1",
  "description": "Cross-platform Node CLI",
  "main": "dist/main.js",
  "bin": {
    "qme": "./dist/main.js"
  },
  "license": "MIT",
  "keywords": ["cli", "node", "cross-platform", "tool"],
  "files": ["index.js", "src"],
  "scripts": {
    "build:win": "pkg index.js --targets node18-win-x64 --output dist/qme-win.exe",
    "nest:build": "tsc -p tsconfig.build.json",
    "nest:start": "node dist/main.js"
  },
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "scripts": [
      "index.js",
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "@nestjs/common": "^10.4.5",
    "@nestjs/core": "^10.4.5",
    "@nestjs/platform-express": "^10.4.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
