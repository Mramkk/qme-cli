{
  "name": "@ramkumarbedia/xqme",
  "version": "2.0.0",
  "description": "Cross-platform Node CLI",
  "main": "index.js",
  "bin": {
    "qme": "./index.js"
  },
  "license": "MIT",
  "keywords": ["cli", "node", "cross-platform", "tool"],
  "files": ["index.js", "src"],
  "scripts": {
    "build:win": "pkg index.js --targets node18-win-x64 --output dist/qme-win.exe"
  },
  "pkg": {
    "targets": [
      "node18-win-x64",
      "node18-macos-x64",
      "node18-linux-x64"
    ],
    "scripts": [
      "index.js",
      "src/**/*.js"
    ]
  },
  "dependencies": {
    "chalk": "^4.1.2"
  }
}