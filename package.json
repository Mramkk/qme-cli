{
  "name": "@ramkumarbedia/xqme",
  "version": "4.0.1",
  "description": "Cross-platform Node CLI",
  "main": "index.js",
  "bin": {
    "qme": "index.js"
  },
  "license": "MIT",
  "keywords": [
    "cli",
    "node",
    "cross-platform",
    "tool"
  ],
  "files": [
    "index.js",
    "src"
  ],
  "scripts": {
    "test": "node --test",
    "check": "npm test && npm run lint && npm run format:check",
    "version:check": "node scripts/check-version.js",
    "lint": "eslint index.js src test",
    "format": "prettier --write src/commands src/services src/errors.js test",
    "format:check": "prettier --check src/commands src/services src/errors.js test"
    
  },
  
  "dependencies": {
    "chalk": "^4.1.2"
  },
  "devDependencies": {
    "eslint": "^10.8.0",
    "prettier": "^3.9.6"
  }
}
